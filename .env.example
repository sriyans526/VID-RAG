# ==============================================================================
# VidRAG Advanced — Environment Variables Configuration Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control!
# ==============================================================================

# --- LLM Provider Settings ---
# Options: 'ollama_cloud' (cloud Ollama API), 'gemini' (Google AI), or 'ollama' (local)
LLM_PROVIDER=ollama_cloud

# Google Gemini Configuration (Required if LLM_PROVIDER=gemini)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Cloud Configuration (Required if LLM_PROVIDER=ollama_cloud)
# Get your API key from Ollama: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_NUM_PREDICT=1024

# Local Ollama Configuration (Used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-nano:30b

# --- Vector Database (Qdrant) ---
# Local Docker: http://localhost:6333 (leave QDRANT_API_KEY blank)
# Qdrant Cloud: https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vidrag_transcripts

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS_OR_LONGER
JWT_EXPIRE_MINUTES=1440

# --- Database & Storage ---
DATABASE_PATH=./data/vidrag.db

# --- Networking & CORS ---
# Comma-separated allowed origins for frontend applications (or * for public testing)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Server Port (defaults to 8000 locally, overridden dynamically by cloud platforms)
PORT=8000

# Input safety limits
MAX_QUESTION_CHARS=2000

# Optional: set this email as admin after registering, via SQLite once only
BOOTSTRAP_ADMIN_EMAIL=
